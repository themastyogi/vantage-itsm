# Neon Postgres connection string — from your Neon project's Connection Details
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Session signing secret — set a long random value in any real deployment
SESSION_SECRET=change-me-to-a-long-random-string

# Microsoft Teams — Incoming Webhook URL from a channel connector
TEAMS_WEBHOOK_URL=

# Email (SMTP) — any provider (Microsoft 365, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=itsm@yourcompany.example
